# Dependencies — never commit; Vercel/CI run their own install.
# (Committing these ships platform-specific binaries like esbuild/rollup
#  that break builds on other OSes.)
node_modules/

# Build output
dist/
*.tsbuildinfo

# Local env files — keep .env.example tracked as the documented template.
.env
.env.*
!.env.example

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.local

# Vercel
.vercel
