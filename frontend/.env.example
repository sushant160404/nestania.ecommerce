# URL of the backend API server. All relative "/api/..." calls and
# "/product_images/..." asset paths are resolved against this URL.
#
# - Local dev (backend on its default port): http://localhost:4000
# - Production: your deployed backend's URL, e.g. https://api.yourdomain.com
#
# Leave empty only if the frontend and backend are served from the exact same
# origin (e.g. both behind the same reverse proxy).
VITE_API_URL="http://localhost:4000"
