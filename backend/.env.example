# Port the API server listens on
PORT=4000

# MongoDB Atlas (or any MongoDB) connection string.
# If unset, the server falls back to in-memory storage automatically.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=Cluster0"

# Comma-separated list of origins allowed to call this API (CORS).
# Should include your frontend's dev URL and its production URL.
CORS_ORIGIN="http://localhost:5173"

NODE_ENV=development
