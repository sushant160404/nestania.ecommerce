# Root-level safety net. backend/ and frontend/ each have their own .gitignore too.

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment / secrets — never commit. Templates (*.example) stay tracked.
.env
.env.*
!.env.example
!.env.production.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.local
